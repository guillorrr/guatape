# Public build-time settings for the SPA. Vite inlines VITE_* into the bundle,
# so never put secrets here. This file is committed on purpose; override
# locally with .env.local (ignored).

# Name shown in the sidebar, the header and the browser tab. Empty: "Guatape".
VITE_APP_NAME=Guatape

# Locale and time zone used to display dates and numbers. The API serves UTC;
# empty values fall back to es-AR / America/Argentina/Buenos_Aires.
VITE_LOCALE=es-AR
VITE_TIME_ZONE=America/Argentina/Buenos_Aires

# Default currency for useCurrency().formatMoney. Empty: ARS.
VITE_CURRENCY=ARS
