APP_NAME=Guatape
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Public origin of the app (nginx serves the SPA and proxies /api and /sanctum here).
APP_URL=https://guatape.local

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Docker defaults; docker-compose.yml overrides these for the api container.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=guatape
DB_USERNAME=guatape
DB_PASSWORD=secret

# --- SPA auth (Sanctum, cookie session) ---
# The SPA authenticates with the session cookie, not with bearer tokens.
# SESSION_DOMAIN: cookie domain. Leave empty (null) for a single host; use a
# leading dot (.example.com) to share the session across subdomains.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Hosts (with port, comma-separated) whose requests get session/CSRF handling.
# If empty, Sanctum falls back to localhost + APP_URL's host; an SPA served from
# any other host gets 401 on every request after login.
SANCTUM_STATEFUL_DOMAINS=guatape.local,localhost,localhost:5173
# Origin of the SPA, used for CORS and for links in emails (password reset).
# If empty, it falls back to APP_URL.
FRONTEND_URL=https://guatape.local

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local mail goes to Mailhog. With MAIL_MAILER=log emails are written to the log
# instead of being sent (safe default when no SMTP is configured).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Public self-registration (POST /api/v1/auth/register). Empty/false: disabled,
# the endpoint answers 404 and only admins create users.
REGISTRATION_ENABLED=false

# Database used by the test suite. Empty: "<DB_DATABASE>_testing", which the db
# container creates on first start (docker/db/init).
DB_TEST_DATABASE=
