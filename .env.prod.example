# =============================================================================
# Production environment — copy to .env.prod in the deploy clone (never commit
# it). docker-compose.prod.yml passes this whole file to every Laravel
# container (api, queue-worker, scheduler) and reads the DB_* / APP_NAME /
# HTTP_PORT values for the other services.
#
# After changing a value: `scripts/deploy.sh` (or recreate the containers with
# `docker compose ... up -d`): running containers don't re-read this file.
# =============================================================================

# --- Compose ---
# Prefix for the image names. Empty: "guatape".
APP_NAME=guatape
# Host port nginx listens on (plain HTTP; put TLS in front). Empty: 8080.
HTTP_PORT=8080

# --- Laravel ---
APP_ENV=production
APP_DEBUG=false
# REQUIRED. Without it every request fails ("No application encryption key").
# Generate once with: docker run --rm php:8.4-cli php -r "echo 'base64:'.base64_encode(random_bytes(32)), PHP_EOL;"
# Changing it later logs everyone out and breaks encrypted columns.
APP_KEY=
# Public URL (scheme + host). Wrong value: wrong links in emails, CORS failures.
APP_URL=https://app.example.com
# Origin of the SPA. Empty: APP_URL (nginx serves both on the same origin).
FRONTEND_URL=
# Default language of the API (lang/<code>). Users can pick another one from
# config app.supported_locales; browsers send theirs. Empty: es.
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_AR

# Proxies whose X-Forwarded-* headers are trusted: "*" only if this app is
# reachable exclusively through the proxy, otherwise its IPs/CIDRs. Empty
# behind a TLS terminator: Laravel thinks requests are http (no secure cookies,
# http:// links) and logs the proxy's IP for every user.
TRUSTED_PROXIES=*

LOG_CHANNEL=stack
# daily: one file per day under storage/logs. Empty: Laravel's default (single).
LOG_STACK=daily
LOG_LEVEL=warning

# --- Database (MySQL container `db`) ---
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
# REQUIRED, all four. They create the database on first start; changing them
# afterwards doesn't rename anything, it just stops the app from connecting.
DB_DATABASE=app
DB_USERNAME=app
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- Session / SPA auth (Sanctum cookie mode) ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
# Send the cookie only over HTTPS. false only if the public URL is plain http.
SESSION_SECURE_COOKIE=true
# Empty: cookie bound to the exact host. ".example.com" shares it across subdomains.
SESSION_DOMAIN=
# REQUIRED. Host(s) of the SPA, with port if not 443, comma-separated. Empty:
# Sanctum assumes localhost and every request after login answers 401.
SANCTUM_STATEFUL_DOMAINS=app.example.com
# Public self-registration. Empty/false: only admins create users.
REGISTRATION_ENABLED=false

# --- Cache / queue (Redis container `redis`) ---
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# --- Mail ---
# log: emails are written to storage/logs instead of sent (password resets
# won't reach anyone). Set smtp (or another mailer) with the values below.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Files ---
# local: storage/app inside the deploy clone. s3: fill the AWS_* values.
FILESYSTEM_DISK=local
# Disk for uploaded attachments. Empty: FILESYSTEM_DISK. Keep it private
# (local or s3 without public ACL): downloads go through the API.
ATTACHMENTS_DISK=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Multi-tenancy (optional, see docs/tenancy.md) ---
# Empty/false: single-tenant app, nothing is scoped. true: organizations are
# resolved per request from <slug>.<central domain> or their own domain.
TENANCY_ENABLED=false
# Host(s) of the central app (super admin, sign-up), comma-separated. Empty:
# APP_URL's host. Tenants answer at <slug>.<first one>. With tenancy on, also
# set SESSION_DOMAIN=.<central domain> and add *.<central domain> to
# SANCTUM_STATEFUL_DOMAINS, or sessions won't work on tenant subdomains.
TENANCY_CENTRAL_DOMAINS=
